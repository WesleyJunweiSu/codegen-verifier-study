FROM python:3.12-slim
RUN pip install --no-cache-dir --no-deps evalplus==0.3.1 && \
    pip install --no-cache-dir numpy==1.26.4 psutil==5.9.8 tempdir==0.7.1 wget==3.2 appdirs==1.4.4 tqdm==4.67.1 multipledispatch==1.0.0 datasets==5.0.0
RUN python -c "from evalplus.data import get_mbpp_plus; from evalplus.eval import untrusted_check; from evalplus.gen.util import trusted_exec"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY scripts/evaluate_linux.py /app/evaluate_linux.py
COPY scripts/test_matrix_linux.py /app/test_matrix_linux.py
COPY scripts/diagnose_legacy_linux.py /app/diagnose_legacy_linux.py
COPY scripts/consensus_development_linux.py /app/consensus_linux.py
COPY scripts/visible_linux.py /app/visible_linux.py
COPY scripts/combine_public_consensus.py /app/combine_public_consensus.py
COPY src/verifier_study /app/verifier_study
COPY data/prompts/mbpp-v0.2.0.jsonl /app/mbpp-prompts.jsonl
ENTRYPOINT ["python", "/app/evaluate_linux.py"]
